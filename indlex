<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Acceso - TurespuestoYa</title>
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
</head>
<body class="bg-slate-900 text-slate-100 min-h-screen flex justify-center items-center font-sans p-4 bg-[radial-gradient(ellipse_at_top_right,_var(--tw-gradient-stops))] from-slate-800 via-slate-900 to-black">

    <div class="bg-slate-800/80 backdrop-blur-md border border-slate-700 p-8 rounded-3xl shadow-2xl w-full max-w-md flex flex-col gap-5">
        <div class="text-center">
            <div class="inline-block bg-amber-500/10 p-3 rounded-full mb-2 border border-amber-500/20">
                <span class="text-3xl">⚙️</span>
            </div>
            <h1 class="text-3xl font-black text-amber-500 tracking-wider">Turespuesto<span class="text-white">Ya</span></h1>
            <p class="text-slate-400 text-sm mt-2">Inicia sesión o regístrate para entrar al buscador</p>
        </div>

        <div class="flex flex-col gap-4 mt-2">
            <div>
                <label class="text-xs text-slate-400 font-bold ml-1 mb-1 block">Correo Electrónico</label>
                <input type="email" id="email" placeholder="ejemplo@correo.com" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-slate-100 focus:outline-none focus:border-amber-500 transition">
            </div>
            
            <div>
                <label class="text-xs text-slate-400 font-bold ml-1 mb-1 block">Contraseña (Mín. 6 caracteres)</label>
                <input type="password" id="password" placeholder="••••••••" class="w-full bg-slate-900 border border-slate-700 rounded-xl px-4 py-3 text-slate-100 focus:outline-none focus:border-amber-500 transition">
            </div>
            
            <p id="msgError" class="text-red-400 text-xs text-center hidden bg-red-500/10 py-2 rounded-lg border border-red-500/20"></p>

            <button id="btnLogin" class="w-full bg-amber-500 hover:bg-amber-400 text-slate-950 font-black py-3.5 rounded-xl transition shadow-lg shadow-amber-500/20">Entrar</button>
            
            <div class="relative flex items-center py-2">
                <div class="flex-grow border-t border-slate-700"></div>
                <span class="flex-shrink-0 mx-4 text-slate-500 text-xs uppercase tracking-wider">O entra rápido con</span>
                <div class="flex-grow border-t border-slate-700"></div>
            </div>

            <!-- BOTÓN DE GOOGLE -->
            <button id="btnGoogle" class="w-full bg-white hover:bg-gray-100 text-slate-900 font-bold py-3.5 rounded-xl transition flex items-center justify-center gap-3 shadow-md">
                <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 48 48" width="24px" height="24px">
                    <path fill="#FFC107" d="M43.611,20.083H42V20H24v8h11.303c-1.649,4.657-6.08,8-11.303,8c-6.627,0-12-5.373-12-12c0-6.627,5.373-12,12-12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C12.955,4,4,12.955,4,24c0,11.045,8.955,20,20,20c11.045,0,20-8.955,20-20C44,22.659,43.862,21.35,43.611,20.083z"/>
                    <path fill="#FF3D00" d="M6.306,14.691l6.571,4.819C14.655,15.108,18.961,12,24,12c3.059,0,5.842,1.154,7.961,3.039l5.657-5.657C34.046,6.053,29.268,4,24,4C16.318,4,9.656,8.337,6.306,14.691z"/>
                    <path fill="#4CAF50" d="M24,44c5.166,0,9.86-1.977,13.409-5.192l-6.19-5.238C29.211,35.091,26.715,36,24,36c-5.202,0-9.619-3.317-11.283-7.946l-6.522,5.025C9.505,39.556,16.227,44,24,44z"/>
                    <path fill="#1976D2" d="M43.611,20.083H42V20H24v8h11.303c-0.792,2.237-2.231,4.166-4.087,5.571c0.001-0.001,0.002-0.001,0.003-0.002l6.19,5.238C36.971,39.205,44,34,44,24C44,22.659,43.862,21.35,43.611,20.083z"/>
                </svg>
                Continuar con Google
            </button>
            <!-- FIN BOTÓN DE GOOGLE -->

            <div class="relative flex items-center py-2">
                <div class="flex-grow border-t border-slate-700"></div>
                <span class="flex-shrink-0 mx-4 text-slate-500 text-xs">¿No tienes cuenta?</span>
                <div class="flex-grow border-t border-slate-700"></div>
            </div>
            <button id="btnRegister" class="w-full bg-slate-700 hover:bg-slate-600 text-white font-bold py-3.5 rounded-xl transition border border-slate-600">Registrarme con correo</button>
        </div>
    </div>

    <script type="module">
        import { initializeApp } from "https://www.gstatic.com/firebasejs/12.19.0/firebase-app.js";
        // Importamos los módulos de Google
        import { getAuth, signInWithEmailAndPassword, createUserWithEmailAndPassword, onAuthStateChanged, GoogleAuthProvider, signInWithPopup } from "https://www.gstatic.com/firebasejs/12.19.0/firebase-auth.js";

        const firebaseConfig = {
            apiKey: "AIzaSyB4xzcn6XKdViHsdGnGJukyqcdAOKWtujg",
            authDomain: "turepuestoya.firebaseapp.com",
            projectId: "turepuestoya",
            databaseURL: "https://turepuestoya-default-rtdb.firebaseio.com",
        };

        const app = initializeApp(firebaseConfig);
        const auth = getAuth(app);
        
        // Inicializamos el proveedor de Google
        const provider = new GoogleAuthProvider();

        onAuthStateChanged(auth, (user) => {
            if (user) window.location.href = "index.html";
        });

        const emailIn = document.getElementById('email');
        const passIn = document.getElementById('password');
        const errorMsg = document.getElementById('msgError');

        function mostrarError(msg) {
            errorMsg.innerText = msg;
            errorMsg.classList.remove('hidden');
        }

        // Login normal
        document.getElementById('btnLogin').addEventListener('click', () => {
            if(!emailIn.value || !passIn.value) return mostrarError("Llena ambos campos");
            signInWithEmailAndPassword(auth, emailIn.value, passIn.value)
                .catch(err => mostrarError("Datos incorrectos o usuario no existe."));
        });

        // Registro normal
        document.getElementById('btnRegister').addEventListener('click', () => {
            if(!emailIn.value || !passIn.value) return mostrarError("Llena ambos campos para registrarte");
            createUserWithEmailAndPassword(auth, emailIn.value, passIn.value)
                .then(() => alert("¡Cuenta creada exitosamente! Bienvenido."))
                .catch(err => mostrarError("Error: La contraseña es muy corta o el correo ya existe."));
        });

        // NUEVO: Inicio de sesión con Google
        document.getElementById('btnGoogle').addEventListener('click', () => {
            // El botón puede deshabilitarse brevemente para evitar doble clic
            document.getElementById('btnGoogle').disabled = true;
            signInWithPopup(auth, provider)
                .then((result) => {
                    // Si todo sale bien, onAuthStateChanged lo redirigirá a index.html
                })
                .catch((error) => {
                    document.getElementById('btnGoogle').disabled = false;
                    mostrarError("Error al iniciar sesión con Google.");
                });
        });
    </script>
</body>
</html>
